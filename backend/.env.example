# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Your deployed frontend URLs (comma-separated for multiple)
# In production on Render, set this to your Vercel frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# ── Database ──────────────────────────────────────────────
# Local MongoDB (default)
# MONGODB_URI=mongodb://localhost:27017/doctor-appointment

# MongoDB Atlas (cloud) — replace <user>, <password>, and <cluster> with your Atlas credentials
# The database name (doctor-appointment) is specified in the URI path
# retryWrites=true&w=majority ensures reliable writes on Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-appointment?appName=doctorapp&retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────
# REQUIRED in production. Use a long random string: `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Default admin seeded by scripts/seed.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Payment gateway (Stripe) ──────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run in demo mode (payments auto-confirmed for testing).
# Add test keys + webhook secret for live Stripe integration.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_CURRENCY=usd

# ── Email notifications ───────────────────────────────────
# Leave SMTP_HOST empty to run in dev mode (emails logged to console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM=DocBook <you@example.com>

# ── Rate limiting (optional overrides) ────────────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_AUTH_MAX=10
